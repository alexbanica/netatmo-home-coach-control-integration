# Copy to .env.local for local development; keep real credentials out of version control.
ACCESS_TOKEN=replace-with-oauth-access-token
# Optional refresh mode requires all three values together:
# REFRESH_TOKEN=replace-with-refresh-token
# CLIENT_ID=replace-with-oauth-client-id
# CLIENT_SECRET=replace-with-oauth-client-secret
NETATMO_USERNAME=replace-with-netatmo-account-email
NETATMO_PASSWORD=replace-with-netatmo-account-password
CONFIG_FILE=./config.json
SYNC_INTERVAL_MINUTES=5
MAX_READING_AGE_MINUTES=15
DRY_RUN=false
