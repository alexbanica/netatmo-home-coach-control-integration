# Copy to .env.local for local development; keep real credentials out of version control.
ACCESS_TOKEN=replace-with-oauth-access-token
# Optional refresh mode requires all three values together:
# REFRESH_TOKEN=replace-with-refresh-token
# CLIENT_ID=replace-with-oauth-client-id
# CLIENT_SECRET=replace-with-oauth-client-secret
NETATMO_USERNAME=replace-with-netatmo-account-email
NETATMO_PASSWORD=replace-with-netatmo-account-password
CONFIG_FILE=./config.json
SYNC_INTERVAL_MINUTES=5
MAX_READING_AGE_MINUTES=15
# Maximum signed correction magnitude per write, in Celsius (default 5; tenths allowed).
MAX_CORRECTION_C=5
# Unchanged room readings before another write is eligible (default 2).
CALIBRATION_RETRY_UNCHANGED_CYCLES=2
# Writable runtime state; mount persistent storage here when running in a container.
CALIBRATION_STATE_FILE=./calibration-state.json
DRY_RUN=false
# Log level: debug, info, warn, or error. Defaults to info; debug includes Netatmo request diagnostics.
LOG_LEVEL=info
