{
  "name": "netatmo-homecoach-true-temperature",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "set -e; eslint .; for f in src/*.js test/*.js scripts/*.js scripts/*.mjs; do [ -f \"$f\" ] || continue; node --check \"$f\"; done",
    "test": "node --test test/*.test.js",
    "start": "node src/index.js",
    "start:local": "node --env-file-if-exists=.env.local src/index.js",
    "test:container": "node scripts/test-container.mjs"
  },
  "dependencies": {
    "tough-cookie": "6.1.0"
  },
  "devDependencies": {
    "eslint": "10.14.0"
  }
}
